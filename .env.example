# Porta do servidor (Render/Railway definem isso automaticamente)
PORT=5000

# Domínios do seu app autorizados a chamar essa API (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:8100,https://seu-dominio-em-producao.com

# --- Firebase Admin ---
# Firebase Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada. Pegue o arquivo JSON baixado, rode:
#   base64 -w 0 serviceAccountKey.json
# e cole o resultado aqui (uma linha só).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Motor de IA ---
# Opção 1 (recomendada, 100% grátis e estável): Groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Opção 2: Hugging Face (router de Inference Providers)
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_API_KEY=hf_xxx
# AI_MODEL=meta-llama/Llama-3.1-8B-Instruct
